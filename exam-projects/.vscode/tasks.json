{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "DOTNET_ROOT": "${workspaceFolder}/.tools/dotnet11",
      "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
      "DOTNET_NOLOGO": "1"
    }
  },
  "tasks": [
    {
      "label": "Exam: build current question",
      "type": "process",
      "command": "${workspaceFolder}/.tools/dotnet11/dotnet",
      "windows": {
        "command": "${workspaceFolder}/.tools/dotnet11/dotnet.exe"
      },
      "args": [
        "build",
        "${fileDirname}/${fileDirnameBasename}.csproj",
        "-c",
        "Debug",
        "--nologo",
        "-m:4"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Exam: run question",
      "type": "process",
      "command": "${workspaceFolder}/.tools/dotnet11/dotnet",
      "windows": {
        "command": "${workspaceFolder}/.tools/dotnet11/dotnet.exe"
      },
      "args": [
        "run",
        "--project",
        "${input:examQuestion}/${input:examQuestion}.csproj",
        "-c",
        "${input:examConfiguration}"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Exam: build",
      "type": "process",
      "command": "${workspaceFolder}/.tools/dotnet11/dotnet",
      "windows": {
        "command": "${workspaceFolder}/.tools/dotnet11/dotnet.exe"
      },
      "args": [
        "build",
        "CSharpExam.slnx",
        "-c",
        "Debug",
        "--nologo",
        "-m:4"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Exam: build current question (Release)",
      "type": "process",
      "command": "${workspaceFolder}/.tools/dotnet11/dotnet",
      "windows": {
        "command": "${workspaceFolder}/.tools/dotnet11/dotnet.exe"
      },
      "args": [
        "build",
        "${fileDirname}/${fileDirnameBasename}.csproj",
        "-c",
        "Release",
        "--nologo",
        "-m:4"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ],
